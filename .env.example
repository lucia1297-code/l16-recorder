# ── 관리자 인증 ─────────────────────────────────────────
# Supabase 미설정 시 이 비밀번호로 관리자 로그인 (설정 안 하면 개발용 기본값 사용 + 콘솔 경고)
VITE_ADMIN_PASSWORD=change-me-please

# 관리자 2단계 인증(OTP)용 휴대폰 번호. 설정하면 로그인 후 이 번호로 인증번호를 보내
# 추가 확인을 요구합니다. 비워두면 2단계 인증을 건너뜁니다.
VITE_ADMIN_PHONE=010-0000-0000

# ── Supabase (선택) ─────────────────────────────────────
# 아래 두 값을 채우면 자동으로 Supabase 사용:
#   - 데이터 저장: results 테이블 (supabase/schema.sql 실행 필요)
#   - 관리자 로그인: Supabase Auth 이메일/비밀번호 (Supabase 대시보드에서 관리자 계정 생성 필요)
# 비워두면 localStorage + 위 VITE_ADMIN_PASSWORD 로 동작 (설정 불필요, 즉시 작동)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── SMS (알리고 Aligo) — 학생/관리자 전화번호 인증(OTP) 발송 ──────────
# https://smartsms.aligo.in 에서 발급. 셋 다 채워야 실제 문자 발송됨.
# 비워두면 문자 발송 대신 브라우저 콘솔에 인증번호를 출력합니다 (데모/테스트용).
VITE_ALIGO_API_KEY=
VITE_ALIGO_USER_ID=
VITE_ALIGO_SENDER=
